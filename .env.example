# Linux hosts only: run the api container as your own uid/gid so files it
# writes into ./backend (pytest cache, generated migrations) aren't root-owned.
# DOCKER_UID=1000
# DOCKER_GID=1000

# Host ports. Change these if something else on your machine already binds
# them — the container-side ports and all internal URLs are unaffected.
# API_PORT=8000
# WEB_PORT=5173
# DB_PORT=5432

# Postgres
POSTGRES_USER=pomodoro
POSTGRES_PASSWORD=pomodoro
POSTGRES_DB=pomodoro
POSTGRES_TEST_DB=pomodoro_test

# Backend — 'db' is the compose service hostname. compose.yaml composes these
# URLs from the POSTGRES_* vars above by default; set them here only to point
# at a database outside compose.
# DATABASE_URL=postgresql+asyncpg://pomodoro:pomodoro@db:5432/pomodoro
# TEST_DATABASE_URL=postgresql+asyncpg://pomodoro:pomodoro@db:5432/pomodoro_test

# Auth. Leave JWT_SECRET as the placeholder for local development: a real
# secret marks the config as deployed, and the app then refuses to start
# without the rest of a deployment's settings (see config.py).
#
# Deploying means changing three things together:
#   JWT_SECRET      openssl rand -hex 32
#   COOKIE_SECURE   true — the refresh cookie is a 30-day credential and must
#                   never travel over plain http
#   CORS_ORIGINS    the real front-end origin, not a loopback address
#
# And one constraint that is not a setting: the front end and the API must
# share a registrable domain (app.example.com + api.example.com is fine;
# app.example.com + api.other.com is not). The refresh cookie is SameSite=Lax,
# so across two different sites the browser never sends it — every user is
# silently logged out at their first refresh, with a 401 that looks like an
# expired session. Splitting the domains means SameSite=None; Secure, which
# then needs CSRF protection this app does not have.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173

# Frontend. Leave this commented out: compose derives it from API_PORT, so
# setting it here silently overrides a changed port and points the browser at
# whatever else is listening on 8000.
# VITE_API_URL=http://localhost:8000

# Hot reload: leave unset. Only set both to 1 if edits on the host stop
# restarting the API / refreshing the browser — some Docker filesystem
# backends don't forward file events through bind mounts.
# WATCHFILES_FORCE_POLLING=1
# VITE_USE_POLLING=1
