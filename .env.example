# Linux hosts only: run the api container as your own uid/gid so files it
# writes into ./backend (pytest cache, generated migrations) aren't root-owned.
# DOCKER_UID=1000
# DOCKER_GID=1000

# Postgres
POSTGRES_USER=pomodoro
POSTGRES_PASSWORD=pomodoro
POSTGRES_DB=pomodoro
POSTGRES_TEST_DB=pomodoro_test

# Backend — 'db' is the compose service hostname. compose.yaml composes these
# URLs from the POSTGRES_* vars above by default; set them here only to point
# at a database outside compose.
# DATABASE_URL=postgresql+asyncpg://pomodoro:pomodoro@db:5432/pomodoro
# TEST_DATABASE_URL=postgresql+asyncpg://pomodoro:pomodoro@db:5432/pomodoro_test

# Auth. Leave JWT_SECRET as the placeholder for local development: a real
# secret marks the config as deployed, and the app then refuses to start with
# a loopback CORS_ORIGINS (see config.py). When you do deploy, generate a
# secret AND set CORS_ORIGINS to the real front-end origin — both together.
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000

# Hot reload: leave unset. Only set both to 1 if edits on the host stop
# restarting the API / refreshing the browser — some Docker filesystem
# backends don't forward file events through bind mounts.
# WATCHFILES_FORCE_POLLING=1
# VITE_USE_POLLING=1
